{
  "name": "copilot-1co",
  "private": true,
  "type": "module",
  "description": "Copilot 1СО — статическое PWA. Сборка не требуется; package.json нужен только для тестов.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npx --yes http-server -p 8080 -c-1 .",
    "lint": "eslint .",
    "bump": "node scripts/bump-version.mjs",
    "check:version": "node scripts/bump-version.mjs --check",
    "check": "npm run lint && npm run check:version && npm test",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "vitest": "^2.1.9"
  }
}
